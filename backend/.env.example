DATABASE_URL=postgresql+psycopg://proofprint:proofprint@127.0.0.1:55432/proofprint
# Set to production after configuring HTTPS, Secure cookies and distinct secrets.
DEPLOYMENT_MODE=development
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_MINUTES=30
AUTH_ISSUER=proofprint
REVIEW_LINK_SECRET_KEY=replace-with-another-32-character-secret
ASSET_ATTESTATION_SECRET_KEY=replace-with-a-third-32-character-secret
ASSET_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,application/pdf
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET_KEY=replace-with-a-fourth-32-character-secret
# Bot Token from Zalo Bot Creator. Keep it only in the server environment.
ZALO_BOT_TOKEN=
# Public frontend origin used in Zalo messages (not 127.0.0.1 in production).
REVIEW_BASE_URL=http://127.0.0.1:3000
GUEST_SESSION_TTL_HOURS=24
GUEST_SESSION_COOKIE_NAME=proofprint_guest_session
GUEST_SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
